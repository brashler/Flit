{
  "name": "flit",
  "version": "0.1.0",
  "description": "Flit is a tiny little physics engine for 3js. CPU-first, GPU-shaped.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bench": "vite-node bench/broadphase.bench.ts && vite-node bench/world.bench.ts",
    "bench:libs": "vite-node bench/morton-libs.bench.ts"
  },
  "keywords": [
    "physics",
    "three.js",
    "spatial-hash",
    "lsh"
  ],
  "license": "MIT",
  "dependencies": {
    "gl-matrix": "^3.4.4"
  },
  "devDependencies": {
    "@thi.ng/morton": "^3.1.151",
    "fast-morton": "^1.1.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
